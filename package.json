    "@types/jasmine": "^3.4.0",
    "@types/node": "^12.7.3",
    "jasmine": "^3.4.0",
    "pta": "^1.2.0",
    "typescript": "^4.2.3",
    "zora": "^6.0.0"
  },
  "optionalDependencies": {
    "rescript": "^12.0.0"
  }
